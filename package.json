{
  "name": "devflow-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workspace-scoped, read-only engineering MCP server and CLI",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "devflow": "./dist/client.js",
    "devflow-server": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "smoke": "npm run build && node dist/client.js tools",
    "start:server": "node dist/server.js",
    "start:client": "node dist/client.js",
    "dev:server": "tsx src/server.ts",
    "dev:client": "tsx src/client.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0"
  }
}
